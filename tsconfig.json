{
  "compilerOptions": {
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2021",
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "bundler",
    "rootDir": "src",
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "strictPropertyInitialization": false,
    "useUnknownInCatchVariables": false,
    "importHelpers": true,
    "noImplicitReturns": true,
    "strictNullChecks": true,
    "lib": [
      "dom",
      "es2021",
      "scripthost",
      "es2015"
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
}
